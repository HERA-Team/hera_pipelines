#! /bin/bash
# Stands in for the librarian CLI in the tests and the demo: "librarian stage-files -w <conn> <dest> <json>" makes
# three empty raw files for the night named in the json's name-matches pattern, in <dest>/<JD>/, but any named in
# FAKE_UNSTAGED (as if the librarian didn't have them).
[[ "$1" == stage-files && "$2" == -w ]] || { echo "fake librarian only does stage-files -w" >&2; exit 2; }
dest=$4
pattern=$(echo "$5" | sed -E 's/.*"name-matches": *"([^"]*)".*/\1/')
jd=$(echo "${pattern}" | cut -d. -f2)
sleep ${FAKE_STAGE_SECONDS:-0}
mkdir -p "${dest}/${jd}"
n=0
for decimal in 12345 13456 14567; do
    name=${pattern/\%/${decimal}}
    if [[ " ${FAKE_UNSTAGED} " != *" ${name} "* ]]; then
        touch "${dest}/${jd}/${name}"
        n=$(( n + 1 ))
    fi
done
echo "Staged ${n} files matching ${pattern} into ${dest}/${jd}"
